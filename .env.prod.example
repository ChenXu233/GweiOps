# Gwei 生产环境变量模板
# 使用方式：
#   1. 复制为 .env.prod：cp .env.prod.example .env.prod
#   2. 填写所有必填项
#   3. docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# 安全警告：
#   .env.prod 包含敏感信息，禁止提交到 Git！
#   生产环境建议使用 Docker Secrets 或 HashiCorp Vault

# ===== 应用配置 =====
APP_NAME=gwei
DEBUG=false

# ===== 数据库配置（必填）=====
# postgres 密码，必须修改
POSTGRES_PASSWORD=changeme_please

# ===== GitHub App 配置（必填）=====
GITHUB_APP_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_INSTALLATION_ID=

# ===== LLM 配置（必填）=====
LLM_PROVIDER=litellm
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_BASE_URL=

# ===== 部署版本（可选，默认为 latest）=====
# GWEI_VERSION=v0.1.0

# ===== 插件 =====
# 外挂插件目录(宿主机路径),挂进容器后由 PLUGINS_EXTRA_DIRS 指向它。
# 装插件 = 放一个 <pkg>/plugin.yaml + plugin.py 进去,再 POST /api/plugins/rescan。
# 不填则用一个不存在的相对路径 compose 会建空目录,引擎读不到任何外部插件。
PLUGINS_EXTRA_DIR=./plugins-extra
# 调一个进程外插件(清单里声明 endpoint 的插件)的超时,秒
PLUGINS_GRPC_TIMEOUT_S=10

# ===== 部署模式 =====
DEPLOYMENT_MODE=self-hosted

# ===== CI 部署(docker-compose.deploy.yml + deploy/ci/)=====
# 下面这些只在走「部署 CI」时需要;上面本机 build 的 prod.yml 用不到。
# 该文件放在目标机 /opt/gwei/.env.prod,权限 600,不进仓库。

# 制品库地址与拉取凭据(用只读部署令牌)
CNB_REGISTRY=docker.cnb.cool
CNB_REGISTRY_USER=cnb
CNB_REGISTRY_TOKEN=
# 当前部署的镜像(含 tag);由 CI 每次部署自动改写,首次可留空
GWEI_ENGINE_IMAGE=
GWEI_WEB_IMAGE=
