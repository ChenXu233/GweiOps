{
  "name": "gwei-frontend",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev:selfhost": "pnpm --filter @gwei/selfhost dev",
    "build:selfhost": "pnpm --filter @gwei/selfhost build",
    "gen:api": "pnpm --filter @gwei/core gen:api"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@nuxt/devtools": "3.3.1"
    }
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}