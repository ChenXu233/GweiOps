# ============================================================
# gwei —— GweiOps 值班
# ------------------------------------------------------------
# 一次事故一个进程:任务从 stdin 读,做完退出,报告写到工作区。
# 用 oh-my-dsh-pack 的镜像,方向(dir)由这份 plan.env 决定。
# 环境用 base 就够:值班要的是 shell + git + dsh,不需要 LibreOffice。
# ============================================================
PLAN_TITLE="GweiOps 值班"
PLAN_DESC="headless:一次事故一个进程,任务从 stdin 读"
PLAN_ENV=base
PLAN_PROFILE=headless
PLAN_ENTRY=headless
