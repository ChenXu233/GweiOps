  "info": {
    "description": "AI 驱动的 GitHub Issue 修复平台",
    "title": "既未 · Gwei",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/changes": {
      "get": {
        "description": "当前状态一栏:每个单元只出现一次,最新的在前。\n\n过滤在截断之前:先按 verdict / binding 收窄,再取前 limit 条,\ntotal 报的是过滤后的总数。没加过滤时把 limit 下推给账本,省得全表取回。",
        "operationId": "list_changes_api_changes_get",
        "parameters": [
          {
            "in": "query",
            "name": "verdict",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Verdict"
            }
          },
          {
            "in": "query",
