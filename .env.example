# Gwei 开发环境变量模板
# 使用方式：
#   1. 复制为 .env：cp .env.example .env
#   2. 修改 LLM_API_KEY 等敏感配置
#   3. docker compose up

# ===== 应用配置 =====
APP_NAME=gwei
DEBUG=true

# ===== 数据库连接（Docker 内部使用服务名）=====
# 开发环境 docker compose 会自动覆盖 DATABASE_URL 为 postgres:5432
DATABASE_URL=postgresql+asyncpg://gwei:gwei@localhost:5432/gwei
REDIS_URL=redis://localhost:6379/0

# ===== GitHub App 配置 =====
# PRIVATE_KEY 写单行:把 .pem 的换行替换成字面量 \n,加载时会还原
# GITHUB_APP_INSTALLATION_ID 取安装页 URL 末尾的数字
GITHUB_APP_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_INSTALLATION_ID=0

# ===== GitLab 适配器(可选)=====
# Webhook 密钥填 GitLab 项目 Webhook 里的 Secret Token;只接合并事件可以不填 TOKEN
GITLAB_BASE_URL=https://gitlab.com
GITLAB_WEBHOOK_SECRET=
GITLAB_TOKEN=

# ===== CNB 适配器(可选)=====
# Webhook 令牌所在的请求头可按你的 CNB 配置改
CNB_BASE_URL=https://api.cnb.cool
# 仓库归档下载走网页端,和 OpenAPI 不是同一个域名
CNB_WEB_BASE_URL=https://cnb.cool
CNB_WEBHOOK_TOKEN=
CNB_WEBHOOK_HEADER=X-Cnb-Token
CNB_TOKEN=

# ===== Harness(可选)=====
# 配了才走外部 agent:一条命令,{workspace} 会替换成沙箱里本次事故的工作区目录
HARNESS_COMMAND=
HARNESS_TIMEOUT_S=1800
# harness 用的控制台令牌,从 API_TOKENS 里发一个给它
HARNESS_TOKEN=
# harness 访问出口用的地址(要能被沙箱访问到)
PLATFORM_BASE_URL=http://127.0.0.1:8000

# 它在哪跑:local(本机)| cnb(CNB 托管执行面)| ssh(一个常开的会话)
SANDBOX=local
# CNB:令牌留空则用上面的 CNB_TOKEN;仓库是承载本次事故的仓库
GWEI_SANDBOX_CNB_REPO=
GWEI_SANDBOX_CNB_IMAGE=cnbcool/default-npc:latest
GWEI_SANDBOX_CNB_EVENT=api_trigger_harness
# ssh:云原生开发环境给的 ssh 地址与私钥
GWEI_SANDBOX_SSH_TARGET=
GWEI_SANDBOX_SSH_KEY_FILE=

# ===== 告警系统适配器(可选)=====
# Alertmanager 投递时带的共享令牌,放在 X-Gwei-Token 头里;不填就拒收投递。
# 接别的告警系统(Caddy、云雀、Grafana)照 plugins/builtin/adapters/alertmanager 写一个适配器,
# 各自的令牌名由该插件自己声明,不需要改 .env 之外的任何核心配置。
ALERTMANAGER_WEBHOOK_TOKEN=

# ===== 注册与账号核验(默认关闭)=====
# 自部署与 SaaS 用同一个开关:关着时只有管理员能在成员页加人。
REGISTRATION_ENABLED=false
# 可用方式:email / phone / oidc(逗号分隔)。没配好的 oidc 不会出现在页面上。
REGISTRATION_METHODS=email
REGISTRATION_REQUIRES_VERIFICATION=true
REGISTRATION_DEFAULT_ROLE=viewer
# 邮件链接与 OIDC 回跳的前台地址;留空按请求 Host 推(反代后面常推错)
REGISTRATION_PUBLIC_BASE_URL=
# 联调用:配了就固定用这个码,并在发码响应里回显。生产务必留空。
REGISTRATION_TEST_CODE=

# 核验通道:console(打进日志)| smtp | resend | webhook
EMAIL_PROVIDER=console
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
RESEND_API_KEY=
# 手机号默认走 webhook:引擎 POST {channel,to,code,purpose,expires_in} 到你自己的短信服务
SMS_PROVIDER=webhook
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# 统一身份(可选)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
OIDC_BUTTON_LABEL=用统一身份登录

# ===== 变更判定 =====
# 允许不经人直接执行的能力,逗号分隔(如 compose.scale,comment.create)。
# 空 = 一律等人:要自动,先点名。写 * 表示不筛,只给演示与测试用。
AUTONOMOUS_CAPABILITIES=

# ===== LLM 配置 =====
LLM_PROVIDER=litellm
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_BASE_URL=

# ===== 插件加载 =====
# 白名单:只加载列出的插件(逗号分隔);不设则按各插件清单的 default_enabled
# PLUGINS_ENABLED=
# 黑名单:在 default_enabled 基础上排除
# PLUGINS_DISABLED=
# 外部插件根(冒号分隔),根下每个 <pkg>/plugin.yaml 是一个插件
# PLUGINS_EXTRA_DIRS=
# 进程外插件清单没写 endpoint 时的地址,name=host:port(逗号分隔)
# PLUGINS_GRPC=
# 调一个远端插件的超时(秒),超时只失败当前调用
# PLUGINS_GRPC_TIMEOUT_S=10

# ===== 发布(PR 合并后) =====
# 三项缺一就不发布:不猜项目目录、服务名与镜像。
# 镜像模板支持 {repo} / {sha} / {number},例如 ghcr.io/example/api:{sha}
RELEASE_PROJECT_DIR=
RELEASE_SERVICE=
RELEASE_IMAGE_TEMPLATE=
# 发布效果打到的下游目标;要与 compose 插件实例的 binding 一致
RELEASE_BINDING=local
# 只发布合入这条基线的 PR;留空 = 任意基线
RELEASE_BASE_BRANCH=

# ===== 变更单元 =====
# 效果执行的下游目标;多目标解析前只有一个
DEFAULT_BINDING=github
# 账本位置(业务库接入前是追加写的文件)
CHANGE_LEDGER_PATH=var/change-ledger.jsonl

# ===== 部署模式 =====
DEPLOYMENT_MODE=self-hosted